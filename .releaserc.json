{
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "installer.exe",
            "name": "IronbugInstaller-win-${nextRelease.version}.exe",
            "label": "IronbugInstaller-win-${nextRelease.version}.exe"
          },
          {
            "path": "ironbug.zip",
            "name": "ironbug-win-${nextRelease.version}.zip",
            "label": "ironbug-win-${nextRelease.version}.zip"
          },
          {
            "path": "ironbug.macos.zip",
            "name": "ironbug.macos-${nextRelease.version}.zip",
            "label": "ironbug.macos-${nextRelease.version}.zip"
          },
          {
            "path": "ironbug.console.win.zip",
            "name": "ironbug.console.win-${nextRelease.version}.zip",
            "label": "ironbug.console.win-${nextRelease.version}.zip"
          },
          {
            "path": "ironbug.console.linux.zip",
            "name": "ironbug.console.linux-${nextRelease.version}.zip",
            "label": "ironbug.console.linux-${nextRelease.version}.zip"
          },
          {
            "path": "ironbug.console.macos.zip",
            "name": "ironbug.console.macos-${nextRelease.version}.zip",
            "label": "ironbug.console.macos-${nextRelease.version}.zip"
          }
        ]
      }
    ]
  ]
}
